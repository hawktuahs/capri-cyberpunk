<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Capri</AssemblyName>
    <RootNamespace>CapriDesktop</RootNamespace>
    <ApplicationIcon>assets\chip.ico</ApplicationIcon>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>5</LangVersion>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="app\*.cs" Exclude="app\Setup.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Security" />
    <Reference Include="System.Speech" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\chip.ico" LogicalName="Capri.Chip.ico" />
    <EmbeddedResource Include="assets\fonts\ShareTechMono-Regular.ttf" LogicalName="Capri.Font.Mono.ttf" />
    <EmbeddedResource Include="assets\sprites\idle.png" LogicalName="Capri.Sprite.idle.png" />
    <EmbeddedResource Include="assets\sprites\blink.png" LogicalName="Capri.Sprite.blink.png" />
    <EmbeddedResource Include="assets\sprites\blink_glitch.png" LogicalName="Capri.Sprite.blink_glitch.png" />
    <EmbeddedResource Include="assets\sprites\grin.png" LogicalName="Capri.Sprite.grin.png" />
    <EmbeddedResource Include="assets\sprites\glitch.png" LogicalName="Capri.Sprite.glitch.png" />
    <EmbeddedResource Include="assets\sprites\dangle.png" LogicalName="Capri.Sprite.dangle.png" />
    <EmbeddedResource Include="assets\sprites\sleep.png" LogicalName="Capri.Sprite.sleep.png" />
    <EmbeddedResource Include="assets\sprites\wake.png" LogicalName="Capri.Sprite.wake.png" />
    <EmbeddedResource Include="assets\sprites\perch.png" LogicalName="Capri.Sprite.perch.png" />
    <EmbeddedResource Include="assets\sprites\perch_blink.png" LogicalName="Capri.Sprite.perch_blink.png" />
    <EmbeddedResource Include="assets\sprites\perch_blink_glitch.png" LogicalName="Capri.Sprite.perch_blink_glitch.png" />
    <EmbeddedResource Include="assets\sprites\perch_glitch.png" LogicalName="Capri.Sprite.perch_glitch.png" />
    <EmbeddedResource Include="assets\sprites\mouth.png" LogicalName="Capri.Sprite.mouth.png" />
    <EmbeddedResource Include="assets\sprites\box_talk.png" LogicalName="Capri.Sprite.box_talk.png" />
    <EmbeddedResource Include="assets\sprites\box_listen.png" LogicalName="Capri.Sprite.box_listen.png" />
    <EmbeddedResource Include="assets\sprites\box_eyes.png" LogicalName="Capri.Sprite.box_eyes.png" />
    <EmbeddedResource Include="assets\sprites\holo_banner.png" LogicalName="Capri.Sprite.holo_banner.png" />
    <EmbeddedResource Include="assets\sprites\holo_call.png" LogicalName="Capri.Sprite.holo_call.png" />
    <EmbeddedResource Include="assets\sprites\hi_box.png" LogicalName="Capri.Sprite.hi_box.png" />
    <EmbeddedResource Include="assets\sprites\box_tenor_talk.png" LogicalName="Capri.Sprite.box_tenor_talk.png" />
    <EmbeddedResource Include="assets\sprites\box_tenor_glitch.png" LogicalName="Capri.Sprite.box_tenor_glitch.png" />
    <EmbeddedResource Include="assets\sprites\box_canon_smirk.png" LogicalName="Capri.Sprite.box_canon_smirk.png" />
    <EmbeddedResource Include="assets\sprites\box_canon_intense.png" LogicalName="Capri.Sprite.box_canon_intense.png" />
    <EmbeddedResource Include="assets\sprites\box_canon_neon.png" LogicalName="Capri.Sprite.box_canon_neon.png" />
    <EmbeddedResource Include="assets\sprites\box_canon_holo.png" LogicalName="Capri.Sprite.box_canon_holo.png" />
    <EmbeddedResource Include="assets\sprites\screen_takeover.png" LogicalName="Capri.Sprite.screen_takeover.png" />
    <EmbeddedResource Include="assets\sprites\box_cutins.png" LogicalName="Capri.Sprite.box_cutins.png" />
  </ItemGroup>
</Project>
